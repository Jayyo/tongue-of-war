# Copy to .env (git-ignored) or export these in your shell. Everything is optional:
# with no key the opponent is the built-in scripted bot.

# One of these turns on the LLM opponent. The first one found is used.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=

# Pick a provider explicitly: openai | gemini | deepseek | openai-compatible
# LLM_PROVIDER=

# Override the model. Defaults: gpt-6-luna, gemini-3.5-flash, deepseek-chat.
# LLM_MODEL=

# Reasoning effort sent with the request (OpenAI reasoning_effort, Gemini thinkingLevel).
# Defaults: "none" for OpenAI, "minimal" for Gemini. Dropped automatically if the model rejects it.
# LLM_REASONING_EFFORT=

# Any OpenAI-compatible chat-completions server, e.g. a local Ollama:
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=

# Upstream time budget per sentence. Waves are 12 s apart.
# LLM_TIMEOUT_MS=9000

# PORT=8123
# HOST=127.0.0.1
